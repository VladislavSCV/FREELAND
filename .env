# App & DB Config
PROJECT_NAME="Freelance OS Production"
POSTGRES_PASSWORD=freelance
# The app uses psycopg; a postgresql+asyncpg:// URL is accepted and converted automatically.
DATABASE_URL=postgresql+psycopg://freelance:freelance@postgres:5432/freelance
REDIS_URL=redis://redis:6379/0
API_TOKEN=GnpzVeDe3H1ui8Q_7PFrsPK16frtfgPOv0U3-B-e-FQ
WEBHOOK_TOKEN=BKGdZH-lF9QAy09KugEoW_5ldvk733YojTUVEShwkdk

# External APIs
# LLM_PROVIDER: yandex | openai | deepseek | anthropic | gemini | mock (offline demo)
LLM_PROVIDER=yandex
LLM_MODEL=yandexgpt-5-lite/latest
# Optional OpenAI-compatible gateway for openai/deepseek, e.g. https://my-proxy.example/v1

LLM_BASE_URL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=sk-53dbda5af1f5457e92c6abf8b36571a1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Yandex AI Studio: API key of a service account and its folder ID
YANDEX_API_KEY=AQVN1-vQUjQb3qSzcyM7AtrBrSG1zzfLSBVO4QmX
YANDEX_FOLDER_ID=b1gtrjme6tts653v5b6j

# Bright Data (optional). Either a proxy URL (http://brd-customer-...-zone-...:pass@brd.superproxy.io:33335)
# or a Web Unlocker API token + zone. Leave empty for direct requests.
BRIGHTDATA_PROXY_URL=
BRIGHTDATA_TOKEN=
BRIGHTDATA_ZONE=
# Sources routed through Bright Data (fl_rss, telegram, kwork or *); the rest go direct
BRIGHTDATA_SOURCES=kwork
BRIGHTDATA_CA_CERT=

# Scraper: fl_rss, telegram, kwork (comma-separated); public channel usernames without @
SCRAPER_ENABLED=true
SCRAPER_SOURCES=fl_rss,telegram,kwork
SCRAPER_INTERVAL_SECONDS=600
SCRAPER_MAX_AGE_HOURS=48
TELEGRAM_CHANNELS=zakazy_it
# Comma-separated feeds. FL.ru category=5 programming, category=2 websites; Kwork c=11 "Разработка и IT"
FL_RSS_URL=https://www.fl.ru/rss/all.xml?category=5,https://www.fl.ru/rss/all.xml?category=2
KWORK_PROJECTS_URL=https://kwork.ru/projects?c=11
# Keyword pre-filter before the LLM (matched at word start): an order needs an include word in title/text
# and no exclude word in the title. Leave SCRAPER_INCLUDE_KEYWORDS empty to send everything to the LLM.
SCRAPER_INCLUDE_KEYWORDS=бот,telegram,телеграм,тг,python,питон,парс,скрипт,crm,амо,amocrm,битрикс,bitrix,интеграц,api,апи,webhook,вебхук,gpt,chatgpt,openai,yandexgpt,llm,нейросет,ии,ai,ai-,автоматизац,автоматиз,mini app,миниапп,fastapi,django,aiogram,лендинг,landing,rag,langchain,crewai,pinecone,dify,мультиагент,база знаний,базы знаний,квалификация лидов,квалификации лидов,автоматизация продаж,чат-бот,docker,kubernetes,k8s,devops,ci/cd,cicd,gitlab,github actions,деплой,задеплоить,развернуть,развертыван,развёртыван,сервер,vps,vds,хостинг,nginx,linux,линукс,администрирован,мониторинг,grafana,prometheus,terraform,ansible,бэкап,резервн,ssl,ollama,vllm,gpu,облак,cloud
SCRAPER_EXCLUDE_KEYWORDS=логотип,дизайн,баннер,видео,монтаж,рилс,reels,прозвон,обзвон,звонк,копирайт,рерайт,статьи,статья,статей,smm,таргет,директ,seo,продвижен,перевод,озвуч,фотограф,иллюстрац,отзыв,1с,1c,unity,wordpress,figma

# Autopilot: score is 1-10. >= AUTOPILOT_THRESHOLD is auto-approved when autopilot is on,
# REVIEW_SCORE..AUTOPILOT_THRESHOLD-1 goes to Telegram review, below REVIEW_SCORE is archived.
# AUTOPILOT_ENABLED is the default; /autopilot on|off in Telegram overrides it.
AUTOPILOT_ENABLED=false
AUTOPILOT_THRESHOLD=7
REVIEW_SCORE=5
MAX_EVALUATIONS_PER_TICK=10

# Telegram Config
TELEGRAM_BOT_TOKEN=8647410673:AAFuRlfAslR8Elm8fSxQ0gPxUJVCNWj0Iiw
ALLOWED_TELEGRAM_IDS=1106972427
# webhook (production, served by the API) | polling (local development, `docker compose --profile polling up`)
TELEGRAM_MODE=polling
WEBHOOK_DOMAIN=https://your-timeweb-domain.ru
# Optional; derived from TELEGRAM_BOT_TOKEN when empty
TELEGRAM_WEBHOOK_SECRET=
# Servers in Russia: Bot API mirror (Cloudflare Worker, docker/telegram-proxy-worker.js) and/or proxy
TELEGRAM_API_URL=
TELEGRAM_PROXY=

# HTTPS (nginx + Let's Encrypt)
DOMAIN=your-timeweb-domain.ru
LETSENCRYPT_EMAIL=you@example.com

# Payment Config. With MANUAL_PAYMENT_MODE=true webhooks are verified and recorded,
# but project status changes only through /pay_project.
MANUAL_PAYMENT_MODE=true
PRODAMUS_SECRET_KEY=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Business settings. Catalog prices and hourly rate are in DEFAULT_CURRENCY;
# CURRENCY_RATES = units of each currency per 1 DEFAULT_CURRENCY (1 RUB = 0.011 USD).
DEFAULT_CURRENCY=RUB
CURRENCY_RATES=USD=0.011,EUR=0.0102
DEFAULT_HOURLY_RATE=1500
MIN_FIT_SCORE=70
MIN_PROFIT_SCORE=60
FOLLOWUP_DAYS=2
SCORE_FIT_WEIGHT=0.35
SCORE_PROFIT_WEIGHT=0.25
SCORE_CLIENT_WEIGHT=0.20
SCORE_RISK_WEIGHT=0.20
REPORTS_DIR=/code/reports
